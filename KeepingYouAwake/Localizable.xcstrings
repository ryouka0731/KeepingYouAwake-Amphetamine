        "id" : { "stringUnit" : { "state" : "translated", "value" : "Tetap aktif selama terhubung ke salah satu jaringan Wi-Fi (SSID) ini." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Resta attivo mentre sei connesso a una di queste reti Wi-Fi (SSID)." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "これらの Wi-Fi ネットワーク（SSID）のいずれかに接続中は有効にします。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Wi-Fi 네트워크(SSID) 중 하나에 연결되어 있는 동안 활성 상태를 유지합니다." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Actief blijven zolang er verbinding is met een van deze wifinetwerken (SSID’s)." } },
