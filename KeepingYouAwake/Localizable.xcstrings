    "Stay active while one of these applications is running." : {
      "comment" : "Stay active while one of these applications is running.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Forbliv aktiv, mens en af disse apps kører." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktiv bleiben, solange eine dieser Apps läuft." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Διατήρηση ενεργοποίησης όσο εκτελείται μία από αυτές τις εφαρμογές." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Mantener activo mientras se ejecute una de estas aplicaciones." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "Pysy aktiivisena, kun jokin näistä sovelluksista on käynnissä." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rester actif tant que l’une de ces applications est ouverte." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "इनमें से कोई ऐप चलने तक सक्रिय रहें।" } },
