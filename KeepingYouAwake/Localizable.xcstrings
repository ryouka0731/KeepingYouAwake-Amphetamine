    "Stay active while a download is in progress in one of these folders." : {
      "comment" : "Stay active while a download is in progress in one of these folders.",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Forbliv aktiv, mens en overførsel er i gang i en af disse mapper." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktiv bleiben, solange in einem dieser Ordner ein Download läuft." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Διατήρηση ενεργοποίησης όσο βρίσκεται σε εξέλιξη λήψη σε έναν από αυτούς τους φακέλους." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Mantener activo mientras haya una descarga en curso en una de estas carpetas." } },
