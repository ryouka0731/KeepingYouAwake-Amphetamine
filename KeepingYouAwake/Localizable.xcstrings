        "da" : { "stringUnit" : { "state" : "translated", "value" : "Skjul nedtælling af resterende tid i menulinjen" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Verbleibende Zeit in der Menüleiste ausblenden" } },
