    "You can still manually enable sleep mode for your Mac." : {
      "comment" : "You can still manually enable sleep mode for your Mac.",
      "localizations" : {
                "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macのスリープは手動で有効にできます。"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan stadig manuelt aktivere vågeblus for din Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst deinen Mac weiterhin manuell in den Ruhezustand versetzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε ακόμα να ενεργοποιήσετε χειροκίνητα την αδράνεια στο Mac σας"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún puedes activar manualmente el modo de reposo en tu Mac."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit silti aktivoida Macin lepotilan manuaalisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez toujours activer manuellement la veille pour votre Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अभी भी अपने Mac के लिए मैन्युअल रूप से स्लीप मोड सक्षम कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi comunque abilitare manualmente la modalità di stop per il tuo Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы по-прежнему можете запустить режим сна вручную."
