        "id" : { "stringUnit" : { "state" : "translated", "value" : "Tetap aktif selama unduhan sedang berlangsung di salah satu folder ini." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Resta attivo mentre è in corso un download in una di queste cartelle." } },
