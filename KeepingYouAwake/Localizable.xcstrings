        "ja" : { "stringUnit" : { "state" : "translated", "value" : "これらのアプリケーションのいずれかが起動中は有効にします。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 앱 중 하나가 실행 중인 동안 활성 상태를 유지합니다." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Actief blijven zolang een van deze apps actief is." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Pozostań aktywny, gdy działa jedna z tych aplikacji." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Manter ativo enquanto um destes aplicativos estiver em execução." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Оставаться активным, пока запущено одно из этих приложений." } },
