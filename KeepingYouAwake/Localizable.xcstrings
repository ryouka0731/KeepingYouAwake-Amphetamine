        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 폴더 중 하나에서 다운로드가 진행 중인 동안 활성 상태를 유지합니다." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Actief blijven zolang er in een van deze mappen een download bezig is." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Pozostań aktywny, gdy w jednym z tych folderów trwa pobieranie." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Manter ativo enquanto houver um download em andamento em uma destas pastas." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Оставаться активным, пока в одной из этих папок идёт загрузка." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zostať aktívny, kým v jednom z týchto priečinkov prebieha sťahovanie." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu klasörlerden birinde indirme devam ederken etkin kal." } },
