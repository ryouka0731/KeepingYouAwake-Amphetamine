        "ko" : { "stringUnit" : { "state" : "translated", "value" : "메뉴 막대의 남은 시간 카운트다운 숨기기" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Resterende tijd in menubalk verbergen" } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Ukryj odliczanie pozostałego czasu na pasku menu" } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Ocultar a contagem decrescente na barra de menus" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скрыть отсчёт оставшегося времени в строке меню" } },
