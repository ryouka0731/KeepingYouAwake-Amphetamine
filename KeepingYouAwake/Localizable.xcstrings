    "Stay active while connected to one of these Wi-Fi networks (SSIDs)." : {
      "comment" : "Stay active while connected to one of these Wi-Fi networks (SSIDs).",
      "localizations" : {
        "da" : { "stringUnit" : { "state" : "translated", "value" : "Forbliv aktiv, mens der er forbindelse til et af disse Wi-Fi-netværk (SSID’er)." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktiv bleiben, solange eine Verbindung zu einem dieser WLAN-Netzwerke (SSIDs) besteht." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Διατήρηση ενεργοποίησης όσο υπάρχει σύνδεση σε ένα από αυτά τα δίκτυα Wi-Fi (SSID)." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Mantener activo mientras esté conectado a una de estas redes Wi-Fi (SSID)." } },
