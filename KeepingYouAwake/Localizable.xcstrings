        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Оставаться активным, пока есть подключение к одной из этих сетей Wi-Fi (SSID)." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Zostať aktívny, kým je pripojenie k jednej z týchto sietí Wi-Fi (SSID)." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu Wi-Fi ağlarından (SSID) birine bağlıyken etkin kal." } },
